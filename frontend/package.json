{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,spa -c blue,green \"npm run dev:backend\" \"npm run dev:vite\"",
    "dev:vite": "vite",
